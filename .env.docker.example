# Copy to .env.docker. Set three different secrets before starting Compose.
APP_KEY=
POSTGRES_ADMIN_PASSWORD=
DB_PASSWORD=

DB_DATABASE=sistema_inmo
DB_USERNAME=inmo_app

# Start on this machine only; switch to the LAN IP or 0.0.0.0 when ready.
ERP_BIND_ADDRESS=127.0.0.1
ERP_PORT=8080
APP_URL=http://localhost:8080
APP_SCHEDULE_TIMEZONE=America/Guayaquil
SESSION_SECURE_COOKIE=false

LOG_LEVEL=info
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=erp@example.test
